<div class="wander-mood-section">

    <div class="mood-header">
        <span class="mood-badge">✨ WANDER MOOD</span>

        <h2>How do you want to travel?</h2>

        <p>
            Choose a mood or a feeling, discover a destination, and let your next adventure unfold.
        </p>
    </div>

    <div class="mood-grid">

        <button class="mood-card" data-mood="rainy">
            <span class="mood-icon">🌧️</span>
            <span class="mood-name">Rainy Escape</span>
            <small>Cozy & peaceful</small>
        </button>

        <button class="mood-card" data-mood="golden">
            <span class="mood-icon">🌅</span>
            <span class="mood-name">Golden Hour</span>
            <small>Warm & beautiful</small>
        </button>

        <button class="mood-card" data-mood="midnight">
            <span class="mood-icon">🌌</span>
            <span class="mood-name">Midnight</span>
            <small>Dark & dreamy</small>
        </button>

        <button class="mood-card" data-mood="forest">
            <span class="mood-icon">🌲</span>
            <span class="mood-name">Forest Escape</span>
            <small>Fresh & natural</small>
        </button>

        <button class="mood-card" data-mood="beach">
            <span class="mood-icon">🌊</span>
            <span class="mood-name">Beach Vibes</span>
            <small>Relax & unwind</small>
        </button>

        <button class="mood-card" data-mood="adventure">
            <span class="mood-icon">🏔️</span>
            <span class="mood-name">Adventure</span>
            <small>Explore & discover</small>
        </button>

        <button class="mood-card" data-mood="cozy">
            <span class="mood-icon">🔥</span>
            <span class="mood-name">Cozy Weekend</span>
            <small>Slow & comfortable</small>
        </button>

        <button class="mood-card" data-mood="roadtrip">
            <span class="mood-icon">🚗</span>
            <span class="mood-name">Road Trip</span>
            <small>Open roads & freedom</small>
        </button>

    </div>

</div>