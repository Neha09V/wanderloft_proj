<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/founder.css">

<link rel="stylesheet" href="/css/home.css">

<div class="founder-page">

    <!-- =========================
         TOP NAVIGATION
    ========================== -->

    <nav class="founder-nav">

        <div class="founder-nav-inner">

            <a href="/home" class="founder-brand">
                Back To Home
            </a>

            <div class="founder-nav-links">

                <a href="#journey">
                    Journey
                </a>

                <a href="#connect">
                    Connect
                </a>

                <a href="/listings">
                    Explore ↗
                </a>

            </div>

        </div>

    </nav>


    <main class="founder-container">


        <!-- =========================
             HERO
        ========================== -->

        <section class="founder-hero">

            <div class="founder-hero-grid">


                <!-- HERO CONTENT -->

                <div class="founder-hero-content">

                    <span class="founder-eyebrow">
                        THE PERSON BEHIND WANDERLOFT
                    </span>

                    <h1>
                        Not a resume line.<br>
                        <em>A running experiment.</em>
                    </h1>

                    <p class="founder-hero-intro">
                        Wanderloft began as a college project. It's turned into
                        something I actually care about — a small proof of what
                        I can build when I stay curious and keep showing up.
                    </p>

                    <div class="founder-hero-actions">

                        <a
                            href="https://www.linkedin.com/in/nehakumari09/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="founder-btn founder-btn-solid"
                        >
                            View LinkedIn
                            <i class="fa-brands fa-linkedin"></i>
                        </a>

                        <a
                            href="/documents/Neha_kumari_Resume.pdf"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="founder-btn founder-btn-ghost"
                        >
                            View Resume
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>

                    </div>

                </div>


                <!-- PROFILE CARD -->

                <div class="founder-profile-card">

                    <div class="founder-profile-photo">

                        <img
                            src="/images/IMAGE NEHA.png"
                            alt="Neha Kumari"
                        >

                        <span class="founder-photo-stub">
                            WL · 2026
                        </span>

                    </div>


                    <div class="founder-profile-body">

                        <h2>
                            Neha Kumari
                        </h2>

                        <p class="founder-profile-role">
                            Founder, Wanderloft ·
                            B.Tech ECE, MNNIT Prayagraj
                        </p>


                        <div class="founder-profile-row">

                            <span>
                                From
                            </span>

                            <strong>
                                Curiosity
                            </strong>

                        </div>


                        <div class="founder-profile-row">

                            <span>
                                To
                            </span>

                            <strong>
                                Software Developer
                            </strong>

                        </div>


                        <div class="founder-profile-row">

                            <span>
                                Status
                            </span>

                            <strong>
                                In transit
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================
             JOURNEY
        ========================== -->

        <section
            class="founder-journey"
            id="journey"
        >

            <div class="founder-route">


                <!-- JOURNEY 01 -->

                <div class="founder-entry">

                    <div class="founder-route-rail">

                        <div class="founder-route-pin"></div>

                    </div>


                    <div class="founder-entry-content">

                        <span class="founder-entry-code">
                            WL–01 · Origin
                        </span>

                        <h2>
                            Learn a little.<br>
                            Build a little <em>more.</em>
                        </h2>

                        <p>
                            I started with the basics — programming,
                            data structures, databases, and understanding
                            how things actually connect under the hood.
                        </p>

                        <p>
                            Then I became more interested in building than
                            simply reading about building. Small programs
                            became web applications. Web applications became
                            full projects backed by APIs, databases, and real data.
                        </p>

                        <p>
                            Not everything worked the first time.
                            That was fine — that's just what building looks like.
                        </p>

                    </div>

                </div>



                <!-- JOURNEY 02 -->

                <div class="founder-entry">

                    <div class="founder-route-rail">

                        <div class="founder-route-pin"></div>

                    </div>


                    <div class="founder-entry-content">

                        <span class="founder-entry-code">
                            WL–02 · Turbulence
                        </span>

                        <h2>
                            Every bug is a<br>
                            <em>lesson in disguise.</em>
                        </h2>

                        <p>
                            Features broke. Tools had to be replaced.
                            Deployments failed for reasons that made
                            little sense at first.
                        </p>

                        <p>
                            There were database problems, UI changes,
                            confusing documentation, and plenty of
                            moments where I had to step back and figure
                            things out again.
                        </p>

                        <p class="founder-strong-line">
                            So I kept coming back to it.
                        </p>

                    </div>

                </div>



                <!-- JOURNEY 03 -->

                <div class="founder-entry">

                    <div class="founder-route-rail">

                        <div class="founder-route-pin"></div>

                    </div>


                    <div class="founder-entry-content">

                        <span class="founder-entry-code">
                            WL–03 · Compass
                        </span>

                        <h2>
                            Better than yesterday<br>
                            is the only <em>benchmark.</em>
                        </h2>

                        <p>
                            I don't have every opportunity handed to me yet —
                            and that's okay. What I can control is how much
                            I learn between now and the next one.
                        </p>

                        <p>
                            Every senior engineer's blog post, every
                            open-source project, every difficult problem,
                            and every "why did you do it this way?"
                            question is an opportunity to learn.
                        </p>

                        <p>
                            I genuinely believe I can become better with
                            time, consistency, and patience.
                        </p>

                        <p class="founder-strong-line">
                            My goal isn't to arrive somewhere finished.
                        </p>

                    </div>

                </div>



                <!-- JOURNEY 04 -->

                <div class="founder-entry">

                    <div class="founder-route-rail">

                        <div class="founder-route-pin"></div>

                    </div>


                    <div class="founder-entry-content">

                        <span class="founder-entry-code">
                            WL–04 · Current position
                        </span>

                        <h2>
                            Still learning.<br>
                            Still building.<br>
                            Still <em>wandering.</em>
                        </h2>

                        <p>
                            I'm continuing to strengthen my full-stack,
                            backend, database, and software development
                            fundamentals — one project at a time.
                        </p>

                        <p>
                            I'm still figuring things out, still making
                            mistakes, and still trying to become better
                            than I was yesterday.
                        </p>

                        <p>
                            Wanderloft isn't the destination.
                            It's a snapshot of where I am right now,
                            on the way to somewhere better.
                        </p>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================
             WHY WANDERLOFT
        ========================== -->

        <section class="founder-postcard-section">

            <div class="founder-postcard">

                <span class="founder-eyebrow">
                    WHY WANDERLOFT
                </span>

                <h2>
                   It started with a simple idea
                  and became <em>mine.</em>
                </h2>

                <p>
                    WanderLoft started as an Airbnb-inspired project. I began with
                  one simple idea — letting people create and explore listings
                 for different places to stay.
                </p>

                <p>
                   As I worked on it, I started thinking beyond just listings.
            I wanted to build something that felt more like the journey
            behind a trip — discovering a place, finding somewhere to stay,
            sharing experiences, and hearing the stories of people who had
            already been there.
                </p>

                <p>
                   That is when the project started becoming more personal. I began
            experimenting with ideas that could make it feel different from
            a typical travel or booking platform — from travel moments and
            stories to blogs, experiences, and ways for people to discover
            places through other people's journeys.
                </p>

               <p>
                    Now it has become a place to discover destinations,
                    explore stays, share travel moments, and experience
                    travel through other people's eyes.
                </p>

                <p class="founder-postcard-final">
                    And I'm still adding to it.
                </p>

            </div>

        </section>



        <!-- =========================
             WHAT'S NEXT
        ========================== -->

        <section
            class="founder-connect"
            id="connect"
        >

            <div class="founder-connect-inner">

                <span class="founder-eyebrow">
                    WHAT'S NEXT?
                </span>

                <h2>
                    Looking for people to build
                    and learn <em>with.</em>
                </h2>

                <p>
                  I'm looking for opportunities where I can learn from others,
                   learn from my mistakes, work on real-world problems, and keep
                    growing and upskilling myself as a developer.
                </p>

                <p>
                    I may still have a lot to learn, but I believe I can
                    get better with every opportunity, every challenge,
                    and every project I take on.
                </p>

                <p>
                    I want to keep building, keep improving, and hopefully
                    look back someday and see how far I came.
                </p>

                <div class="founder-connect-actions">

                    <a
                        href="https://www.linkedin.com/in/nehakumari09/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="founder-btn founder-btn-solid"
                    >
                        View my LinkedIn
                        <i class="fa-brands fa-linkedin"></i>
                    </a>

                    <a
                        href="/documents/Neha_kumari_Resume.pdf"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="founder-btn founder-btn-ghost"
                    >
                        View my Resume
                        <i class="fa-solid fa-file-lines"></i>
                    </a>

                    <a
                        href="/listings"
                        class="founder-btn founder-btn-ghost"
                    >
                        Explore Wanderloft
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                </div>

            </div>

        </section>



        <!-- =========================
             CLOSING
        ========================== -->

        <section class="founder-closing">

            <span>
                ✦
            </span>

            <h2>
                Every project teaches something.
                Every journey leads somewhere.
                I'm just getting started.
            </h2>

            <p>
                This is one chapter — not the whole story.
            </p>

        </section>


    </main>

</div>