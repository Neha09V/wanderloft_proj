<% layout("/layouts/boilerplate") %>

<div class="create-post-page">

    <div class="create-post-card">

           <div class="text-center mb-4">

            <h2
                style="
                    font-family: Georgia,  serif;
                    font-size: 2rem;
                    font-weight: 300;
    
                    color: #182020;
                "
            >
                ✨ Share Your Moment
            </h2>

            <p class="text-muted fs-5">
                Turn a beautiful memory into a story worth wandering through.
            </p>

        </div>

        <form 
            action="/community" 
            method="POST" 
            enctype="multipart/form-data"
            class="post-form"
        >

            <!-- CAPTION -->

            <label class="form-label">
                Write Your Moment
            </label>

            <textarea 
                name="community[caption]" 
                placeholder="Describe your travel memory..."
                required
                class="form-control mb-4"
                rows="5"
            ></textarea>

            <!-- LOCATION -->

            <label class="form-label">
                Location
            </label>

            <input 
                type="text" 
                name="community[location]" 
                placeholder="Enter location"
                required
                class="form-control mb-4"
            >

            <!-- IMAGE -->

            <label class="form-label">
                Upload a Picture
            </label>

            <input 
                type="file" 
                name="image" 
                required
                class="form-control mb-4"
            >

            <!-- BUTTON -->

            <button class="post-btn">
                Post Moment ✨
            </button>

        </form>

    </div>

</div>