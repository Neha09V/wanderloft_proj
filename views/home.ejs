<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/home.css">

<div class="home-page">

    <!-- HERO -->
    <section class="home-hero">

        <div class="home-hero-content">

            <img src="/images/Wanderloftimg.png"
                 alt="Wanderloft"
                 class="home-logo">

            <p class="home-eyebrow">WELCOME TO WANDERLOFT</p>

            <h1>
                Discover places.<br>
                Create memories.
            </h1>

            <p class="home-description">
                Explore unique destinations, discover inspiring stays,
                and experience the world through fellow wanderers.
            </p>

            <a href="/listings" class="home-explore-btn">
                Explore Wanderloft
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>

    </section>


    <!-- DISCOVER -->
    <section class="home-discover">

        <div class="discover-heading">

            <p class="discover-eyebrow">EXPLORE YOUR WAY</p>

            <h2>Where will you wander?</h2>

            <p>
                Find inspiration for your next escape,
                from peaceful mountains to unforgettable beaches.
            </p>

        </div>

       <div class="category-slider-wrapper">

    <button class="category-arrow category-prev" type="button">
        <i class="fa-solid fa-chevron-left"></i>
    </button>

    <div class="category-slider">


        <a href="/listings/filter/Mountains" class="category-card">
            <img src="/images/mountains.png" alt="Mountains">
            <div class="category-card-content">
                <span>01</span>
                <h3>Mountains Retreats</h3>
                <p>Escape into the wild</p>
            </div>
        </a>

        <a href="/listings/filter/Farm" class="category-card">
            <img src="/images/nature.png" alt="nature">
            <div class="category-card-content">
                <span>02</span>
                <h3>Farms & Estates</h3>
                <p>Slow down and reconnect</p>
            </div>
        </a>

        <a href="/listings/filter/Camping" class="category-card">
            <img src="/images/camping.png" alt="camping">
            <div class="category-card-content">
                <span>03</span>
                <h3>Camping</h3>
                <p>Sleep beneath the stars</p>
            </div>
        </a>

        <a href="/listings/filter/Amazing-Pools" class="category-card">
            <img src="/images/lakes.png" alt="amazing pools">
            <div class="category-card-content">
                <span>04</span>
                <h3>Amazing Pools</h3>
                <p>Relax in style</p>
            </div>
        </a>

        <a href="/listings/filter/Iconic-Cities" class="category-card">
            <img src="/images/city-escapes.png" alt="iconiccities">
            <div class="category-card-content">
                <span>05</span>
                <h3>Iconic Cities</h3>
                <p>Experience the extraordinary</p>
            </div>
        </a>

        <a href="/listings/filter/Countryside" class="category-card">
            <img src="/images/desert.png" alt="countryside">
            <div class="category-card-content">
                <span>06</span>
                <h3>Countryside</h3>
                <p>Peace beyond the city</p>
            </div>
        </a>

        <a href="/listings/filter/Beach" class="category-card">
            <img src="/images/beaches.png" alt="beaches">
            <div class="category-card-content">
                <span>07</span>
                <h3>Beaches</h3>
                <p>Follow the horizon</p>
            </div>
        </a>

        <a href="/listings/filter/Castles" class="category-card">
            <img src="/images/heritage.png" alt="castle">
            <div class="category-card-content">
                <span>08</span>
                <h3>Castles</h3>
                <p>Stay somewhere timeless</p>
            </div>
        </a>

        <a href="/listings/filter/Arctic" class="category-card">
            <img src="/images/adventure.png" alt="Arctic">
            <div class="category-card-content">
                <span>9</span>
                <h3>Arctic Escapes</h3>
                <p>Discover another world</p>
            </div>
        </a>

    </div>

    <button class="category-arrow category-next" type="button">
        <i class="fa-solid fa-chevron-right"></i>
    </button>

</div>
    </section>
    <section class="why-wanderloft">

    <div class="why-heading">
        <p>THE WANDERLOFT EXPERIENCE</p>
        <h2>Travel differently.</h2>
        <span>
            Discover places, stories and experiences worth remembering.
        </span>
    </div>

    <div class="why-grid">

        <div class="why-card">
            <i class="fa-solid fa-compass"></i>
            <h3>Discover</h3>
            <p>
                Find inspiring destinations and unique places
                beyond the usual tourist spots.
            </p>
        </div>

        <div class="why-card">
            <i class="fa-solid fa-camera-retro"></i>
            <h3>Share</h3>
            <p>
                Share your favorite places and travel moments
                with fellow wanderers.
            </p>
        </div>

        <div class="why-card">
            <i class="fa-solid fa-earth-americas"></i>
            <h3>Explore</h3>
            <p>
                Explore the world through a community of
                passionate travelers.
            </p>
        </div>

    </div>

</section>
<section class="featured-experiences">

    <div class="featured-heading">
        <div>
            <p>CURATED FOR YOU</p>
            <h2>Places worth discovering.</h2>
        </div>

        <a href="/listings" class="view-all-btn">
            View all
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    <div class="featured-grid">

        <a href="/listings" class="featured-card">
            <div class="featured-card-image">
                <img src="/images/worthmountain.jpg" alt="Mountain escape">
            </div>

            <div class="featured-card-content">
                <span>ESCAPE</span>
                <h3>Into the mountains</h3>
                <p>Find your quiet place above the clouds.</p>
            </div>
        </a>

        <a href="/listings" class="featured-card">
            <div class="featured-card-image">
                <img src="/images/bythesea.jpg" alt="Beach escape">
            </div>

            <div class="featured-card-content">
                <span>UNWIND</span>
                <h3>By the sea</h3>
                <p>Slow mornings and endless horizons.</p>
            </div>
        </a>

        <a href="/listings" class="featured-card">
            <div class="featured-card-image">
                <img src="/images/starscamping.jpg" alt="Camping experience">
            </div>

            <div class="featured-card-content">
                <span>ADVENTURE</span>
                <h3>Under the stars</h3>
                <p>Reconnect with nature and yourself.</p>
            </div>
        </a>

    </div>

</section>

<!-- =========================
     WANDER MOMENTS
========================= -->

<section class="home-moments">

    <div class="moments-heading">

        <div>
            <p class="moments-eyebrow">WANDER MOMENTS</p>

            <h2>Stories worth getting lost in.</h2>

            <p>
                Discover real places, beautiful memories and inspiring
                journeys shared by fellow wanderers.
            </p>
        </div>

        <a href="/community" class="moments-view-all">
            Explore Community
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </div>


    <div class="moments-grid">

        <% if (posts && posts.length > 0) { %>

            <% posts.slice(0, 3).forEach(post => { %>

                <a
                    href="/community/<%= post._id %>"
                    class="moment-card"
                >

                    <div class="moment-image-wrapper">

                        <img
                            src="<%= post.image %>"
                            alt="Travel moment"
                            class="moment-image"
                        >

                        <div class="moment-overlay">
                            <span>
                                View Story
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>

                    </div>


                    <div class="moment-content">

                        <div class="moment-location">

                            <i class="fa-solid fa-location-dot"></i>

                            <span>
                                <%= post.location %>
                            </span>

                        </div>


                        <p class="moment-caption">

                            <%= post.caption.length > 95
                                ? post.caption.substring(0, 95) + "..."
                                : post.caption
                            %>

                        </p>


                        <div class="moment-author">

                            <span>Shared by</span>

                            <strong>
                                <%= post.author?.username || "Wander User" %>
                            </strong>

                        </div>

                    </div>

                </a>

            <% }) %>

        <% } else { %>

            <div class="moments-empty">

                <i class="fa-regular fa-compass"></i>

                <h3>Your next story starts here.</h3>

                <p>
                    Be the first wanderer to share a memorable journey.
                </p>

                <a href="/community/new">
                    Share a Wander Moment
                </a>

            </div>

        <% } %>

    </div>


    <% if (posts && posts.length > 0) { %>

        <div class="moments-bottom">

            <a href="/community" class="moments-community-btn">
                Discover more stories
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>

    <% } %>

</section>

</div>
<script src="/js/home.js"></script>