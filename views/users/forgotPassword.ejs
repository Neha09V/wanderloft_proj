<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <div class="login-signup-form-inp">
    <h3>Forgot Password?</h3>
    <p class="text-muted">Enter your email and we'll help you get back into your Wanderloft account.</p>

    <form action="/forgot-password" method="POST">
      <div class="mb-3">
        <label>Email</label>
        <input type="email" name="email" class="form-control" required>
      </div>

      <button class="btn btn-primary">Find My Account</button>
    </form>
  </div>
</div>