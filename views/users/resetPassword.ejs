<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <div class="login-signup-form-inp">

    <h3>Set a New Password</h3>

    <p class="text-muted">
      Welcome back, <%= user.username %>! Create a new password to continue your journey with Wanderloft.
    </p>

    <form action="/reset-password/<%= user._id %>" method="POST">

      <div class="mb-3">
        <label>New Password</label>
        <input
          type="password"
          name="password"
          class="form-control"
          required
        >
      </div>

      <button class="btn btn-success">
        Update My Password
      </button>

    </form>

  </div>
</div>